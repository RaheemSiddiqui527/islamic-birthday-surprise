# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel)
# ==============================================================================
#
# 1. LOCAL DEVELOPMENT:
# Leave VITE_API_URL empty. Vite proxy in vite.config.js will forward /api to http://localhost:5000.
#
# 2. VERCEL PRODUCTION DEPLOYMENT:
# Set VITE_API_URL to your Render backend URL (e.g. https://kareem-bhai-surprise.onrender.com)
#
VITE_API_URL=
